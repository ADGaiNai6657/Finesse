# D-22：固定上游源码，配置期间校验；构建不触发网络下载。
set(XDELTA_VENDOR_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/third_party/xdelta")
file(STRINGS "${XDELTA_VENDOR_ROOT}/SOURCE-MANIFEST.csv" XDELTA_FILE_ROWS)
list(REMOVE_AT XDELTA_FILE_ROWS 0)
foreach(ROW IN LISTS XDELTA_FILE_ROWS)
    string(REPLACE "," ";" FIELDS "${ROW}")
    list(GET FIELDS 0 FILE_PATH)
    list(GET FIELDS 1 EXPECTED_HASH)
    file(SHA256 "${XDELTA_VENDOR_ROOT}/${FILE_PATH}" ACTUAL_HASH)
    if(NOT ACTUAL_HASH STREQUAL EXPECTED_HASH)
        message(FATAL_ERROR "Pinned xdelta source changed: ${FILE_PATH}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${XDELTA_VENDOR_ROOT}/${FILE_PATH}")
endforeach()
file(SHA256 "${XDELTA_VENDOR_ROOT}/SOURCE-MANIFEST.csv" XDELTA_VENDOR_DIGEST)
file(READ "${XDELTA_VENDOR_ROOT}/SOURCE-MANIFEST.csv" XDELTA_SOURCE_FILES_CSV)

set(XD3_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(XD3_BUILD_LIB ON CACHE BOOL "" FORCE)
set(XD3_ARMOR OFF CACHE BOOL "" FORCE)
set(XD3_LZMA_MODE off CACHE STRING "" FORCE)
set(XD3_LZMA_FETCH OFF CACHE BOOL "" FORCE)
set(XD3_LIB_LZMA OFF CACHE BOOL "" FORCE)
set(XD3_SECONDARY_FGK OFF CACHE BOOL "" FORCE)
set(XD3_LARGESIZET ON CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
add_subdirectory(third_party/xdelta/xdelta3 third_party/xdelta-build EXCLUDE_FROM_ALL)
get_target_property(XDELTA_SOURCE_VERSION xdelta3lib VERSION)
if(NOT XDELTA_SOURCE_VERSION STREQUAL "3.2.2")
    message(FATAL_ERROR "Unexpected pinned xdelta version")
endif()
# 使用上游已有的 memcpy 读取分支，避免硬件允许未对齐访问时的 C 指针对齐 UB。
target_compile_definitions(xdelta3lib PRIVATE HAVE_ALIGNED_ACCESS_REQUIRED=1)
if(FINESSE_SANITIZERS)
    target_compile_options(xdelta3lib PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(xdelta3lib INTERFACE -fsanitize=address,undefined)
endif()
